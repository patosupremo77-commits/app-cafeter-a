rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isStaff() {
      return signed() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Solo se crea a mano en la consola de Firebase. Nadie puede escribirla desde la app.
    match /staff/{id} {
      allow read: if signed() && request.auth.uid == id;
      allow write: if false;
    }

    match /users/{id} {
      allow read, write: if signed() && request.auth.uid == id;
    }

    // Clientes: solo productos visibles. Cafetería: todo.
    match /menu/{id} {
      allow read: if signed() && (isStaff() || resource.data.available == true);
      allow write: if isStaff();
    }

    match /settings/{id} {
      allow read: if signed();
      allow write: if isStaff();
    }

    match /orders/{id} {
      allow read: if signed() && (isStaff() || resource.data.uid == request.auth.uid);
      // El cliente solo crea pedidos propios en estado "recibido".
      // Precios, total y existencias los valida la Cloud Function.
      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'recibido'
        && request.resource.data.source == 'app';
      // Cafetería cambia estados. El cliente solo puede cancelar el suyo si sigue "recibido".
      allow update: if isStaff()
        || (signed() && resource.data.uid == request.auth.uid
            && resource.data.status == 'recibido'
            && request.resource.data.status == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if false;
    }
  }
}
